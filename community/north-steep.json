{
  "$schema": "https://layerscape.app/schema.json",
  "version": 1,
  "id": "north-steep",
  "label": "North steeps",
  "compute": [
    "// One gradient, read twice: how steep, and which way the slope faces.",
    "vec2 g = gradient(u_window);",
    "value = slopeDeg(g);",
    "alpha = facing(aspectDeg(g), 0.0, u_halfWidth);"
  ],
  "uniforms": [
    { "name": "u_window", "label": "Slope window (m)", "type": "float", "value": 10, "min": 2, "max": 50, "step": 1 },
    { "name": "u_halfWidth", "label": "Within ± of north (°)", "type": "float", "value": 45, "min": 10, "max": 90, "step": 5 }
  ],
  "presentation": {
    "kind": "scale",
    "scale": {
      "scaleType": "threshold",
      "title": "Slope angle",
      "tickFormat": ".0f",
      "unit": "°",
      "domain": [30, 35, 40, 45, 50],
      "range": [[236, 224, 107], [238, 144, 104], [223, 107, 125], [211, 167, 200], [175, 175, 175]]
    },
    "footnote": "Only slopes facing within the set angle of north"
  }
}
