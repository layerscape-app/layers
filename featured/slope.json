{
  "$schema": "https://layerscape.app/schema.json",
  "version": 1,
  "id": "slope",
  "label": "Slope",
  "author": "Layerscape",
  "compute": [
    "// Horn's slope over a window of u_distance metres (see the guide's helper reference).",
    "value = slopeDeg(u_distance);"
  ],
  "uniforms": [{ "name": "u_distance", "label": "Slope distance (m)", "type": "float", "value": 10, "min": 2, "max": 50, "step": 1 }],
  "presentation": {
    "kind": "scale",
    "scale": {
      "scaleType": "threshold",
      "title": "Slope angle",
      "tickFormat": ".0f",
      "unit": "°",
      "domain": [30, 35, 40, 45, 50],
      "range": [[236, 224, 107], [238, 144, 104], [223, 107, 125], [211, 167, 200], [175, 175, 175]]
    }
  }
}
